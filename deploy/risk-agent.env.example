# 每个 Agent 只绑定一个租户和一个区服。标识只允许 A-Z、a-z、0-9、点、下划线和横线。
PGR_TENANT_ID=replace-with-tenant-id
PGR_SERVER_ID=replace-with-server-id

# 至少 32 字节随机值，只供本机插件/SDK 调用 Agent，不能使用后台登录卡密。
PGR_LOCAL_TOKEN=<replace-with-random-local-token>

PGR_AGENT_PORT=17870
PGR_QUEUE_DB=/opt/game-behavior-risk/data/plugin-events.db
PGR_MODE=shadow

# Realtime shadow thresholds. Tune per game economy after observing at least one week.
PGR_GOLD_GAIN_10M=1000000
PGR_ASSET_MOVES_10M=5
PGR_HIGH_VALUE_GOLD=1000000
PGR_HIGH_VALUE_ASSET_QUANTITY=20
