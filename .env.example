# 复制成 .env.local。数据库连接在网页「规则与设置」页配置并加密保存，不写在这里。

# 控制台登录卡密（自己设一个）
RISK_PORTAL_KEY=换成你自己的卡密

# 32 字节独立配置主密钥（64 个十六进制字符），不能与卡密复用。
# Linux 安装器会自动生成；手工启动可用：openssl rand -hex 32
RISK_CONFIG_MASTER_KEY=换成64个十六进制字符

# 本地监听端口
RISK_PORT=4173

# 默认仅本机访问；部署到内网服务器时改为 0.0.0.0，并配合防火墙限制来源。
RISK_HOST=127.0.0.1

# 平台远程 SDK 网关转发到本机 Agent 时使用。不要与后台卡密或客户 SDK 密钥复用。
# PGR_AGENT_LOCAL_TOKEN=至少32字节随机值
# PGR_AGENT_PORT=17870

# 客户侧 Agent 可靠上送到本控制台 SDK 网关时使用。URL 必须是 HTTPS，Token 为绑定区服的 SDK 密钥。
# PGR_UPSTREAM_URL=https://risk.example.com/sdk/v1
# PGR_UPSTREAM_TOKEN=至少32字节的区服SDK密钥
# PGR_DELIVERY_BATCH_SIZE=100
# PGR_DELIVERY_MAX_ATTEMPTS=20

# 生产环境在受控 HTTPS 反向代理后开启；封闭实验网络才允许 RISK_SDK_ALLOW_INSECURE=1。
# RISK_BEHIND_TLS_PROXY=1
# 只信任这些反向代理设置的 X-Forwarded-For / X-Forwarded-Proto，多个地址用逗号分隔。
# RISK_TRUSTED_PROXY_IPS=127.0.0.1,::1,::ffff:127.0.0.1
# RISK_SDK_ALLOW_INSECURE=0

# AI Provider 在网页「规则与设置」中配置并加密保存。以下只用于运维调优，不填写 API Key。
# RISK_AI_REVIEW_INTERVAL_MS=60000
# RISK_AI_MAX_REVIEWS_PER_HOUR=30
# RISK_AI_CONFIG_PATH=./data/ai-provider.enc.json
# RISK_AI_REVIEWS_PATH=./data/ai-reviews.json

# 下面是可选项：想跳过网页配置、直接用环境变量启动实时模式时才填。
# WDSF_LIVE=1
# WDSF_HOST=游戏数据库地址
# WDSF_DB_PORT=3306
# WDSF_DB_USER=只读数据库账号
# WDSF_DB_PASSWORD=只读数据库密码
# WDSF_MDB=dl_mdb_1
# WDSF_LDB=dl_ldb_1
